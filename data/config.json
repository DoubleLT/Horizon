{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 1,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2,
    "languages": [
      "zh",
      "en"
    ]
  },
  "sources": {
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "twitter": {
      "enabled": true,
      "apify_token_env": "APIFY_TOKEN",
      "users": [
        "https://x.com/MecAgent",
        "https://x.com/drfeifei",
        "https://x.com/adamdotnew",
        "https://x.com/GoogleDeepMind",
        "https://x.com/tech_shrimp",
        "https://x.com/lukas_m_ziegler",
        "https://x.com/SpaceX",
        "https://x.com/karpathy",
        "https://x.com/ylecun",
        "https://x.com/StanfordAILab",
        "https://x.com/berkeley_ai",
        "https://x.com/ClaudeDevs",
        "https://x.com/claudeai",
        "https://x.com/RodmanAi",
        "https://x.com/AndrewYNg"
      ],
      "fetch_limit": 20,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "rss": [
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/blog/rss.xml",
        "enabled": false,
        "category": "ai"
      },
      {
        "name": "DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": false,
        "category": "ai"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": false,
        "category": "ai-tools"
      }
    ]
  },
  "filtering": {
    "ai_score_threshold": 0.0,
    "time_window_hours": 24
  }
}